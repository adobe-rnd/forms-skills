-- Infrastructure Mode / CDN: CloudFront error and latency analysis for a specific URI
-- Placeholders: __HOST__, __URI_FILTER__, __EARLIEST__, __LATEST__
--
-- __HOST__       : CloudFront distribution ID filter (e.g. E1ABC2DEF3GHI* or *).
-- __URI_FILTER__ : API path or asset URL. Use "*" for all.
-- __EARLIEST__   : Unix epoch integer — substituted by splunk-runner-infra.py
-- __LATEST__     : Unix epoch integer — substituted by splunk-runner-infra.py
--
-- Returns: 4xx/5xx counts grouped by HTTP status + cache status, with latency stats.
-- Cache status: Hit = served from cache; Miss = fetched from origin; Error = CF error;
--               Bypass = cache bypassed. "Error" with status 5xx means origin unreachable.

search index=dx_ams_aws_cf host="__HOST__" earliest=__EARLIEST__ latest=__LATEST__
| search "__URI_FILTER__"
| rex field=_raw "(?<status>\d{3})\s+(?<sc_bytes>\d+)\s+(?<cs_uri_stem>[^\s]+)\s+(?<cs_uri_query>[^\s]+)\s+(?<x_edge_response_result_type>[^\s]+)"
| rex field=_raw "\s(?<x_edge_location>[A-Z]{3}\d+)\s"
| rex field=_raw "\s(?<time_taken>[\d.]+)\s+(?<x_forwarded_for>[^\s]+)\s+(?<ssl_protocol>[^\s]+)"
| eval status=tonumber(status)
| eval time_taken_ms=round(tonumber(time_taken)*1000, 0)
| where status>=400
| stats
    count as occurrences,
    avg(time_taken_ms) as avg_origin_ms,
    max(time_taken_ms) as max_origin_ms,
    max(_time) as last_ts,
    min(_time) as first_ts,
    values(x_edge_location) as edge_locations,
    values(cs_uri_stem) as uris
    by status, x_edge_response_result_type
| eval last_seen=strftime(last_ts,"%Y-%m-%d %H:%M:%S")
| eval first_seen=strftime(first_ts,"%Y-%m-%d %H:%M:%S")
| eval avg_origin_ms=round(avg_origin_ms,0)
| rename x_edge_response_result_type as cache_status
| fields - last_ts, first_ts
| sort -occurrences
